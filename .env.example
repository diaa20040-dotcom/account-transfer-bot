BOT_TOKEN=your_bot_token_here
BOT_USERNAME=YourBotUsername

# Comma-separated Telegram user IDs who receive new transfer alerts
ADMIN_TELEGRAM_IDS=123456789
# JustRunMyApp and similar hosts may use ADMIN_IDS instead (same value)
ADMIN_IDS=123456789
# Or usernames (without @) — user must have pressed Start on the bot once
ADMIN_TELEGRAM_USERNAMES=yourusername

# Web admin panel
ADMIN_PASSWORD=change_me_strong_password
SECRET_KEY=random_secret_for_sessions
HOST=0.0.0.0
PORT=8765

DATABASE_URL=sqlite:///./data/bot.db

# Low-RAM hosts (JustRunMyApp): keep false — use in-bot /admin instead
ENABLE_WEB_ADMIN=false

# Cloud (Render sets RENDER_EXTERNAL_URL automatically → webhook mode)
# PUBLIC_URL=https://your-service.onrender.com
